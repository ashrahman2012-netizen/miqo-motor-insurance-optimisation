{
  "version": "0.2.0",
  "build": {
    "windows": {
      "staticVCRuntime": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MIQO Prototype",
    "icon": ["icons/icon.png"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
