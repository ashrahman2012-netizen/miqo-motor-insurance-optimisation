MIQO_ENV=local
MIQO_DATA_CLASSIFICATION=SYNTHETIC
MIQO_LIVE_PROVIDERS_ENABLED=false
DATABASE_URL=postgresql://miqo:miqo@127.0.0.1:5432/miqo
CUSTOMER_WEB_URL=http://127.0.0.1:3000
ADMIN_WEB_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_ADMIN_WEB_URL=http://127.0.0.1:3001

# MIQOS-CXM-FORM-SUBMIT-001 — keep false until explicitly running the synthetic direct-form gateway.
MIQO_FORM_SUBMISSION_ENABLED=false
# Allows Origin: null from a downloaded file:// form in the synthetic local environment only.
MIQO_ALLOW_FILE_ORIGIN=false
# Optional explicit Chrome/Edge executable. Auto-detected on common Windows/macOS/Linux installations.
MIQO_CHROME_EXECUTABLE=
# Gmail API OAuth credentials. Never commit real values.
MIQO_GMAIL_CLIENT_ID=
MIQO_GMAIL_CLIENT_SECRET=
MIQO_GMAIL_REFRESH_TOKEN=
MIQO_GMAIL_SENDER=miqos.new@gmail.com
MIQO_GMAIL_RECIPIENT=miqos.new@gmail.com
