  "ownership": {
    "packages/ui": "presentation-only",
    "apps/customer-web": "customer routing/page composition/application orchestration",
    "apps/admin-web": "admin routing/page composition/application orchestration",
    "p4-contract-layer": "api-to-viewmodel mapping",
    "apps/api": "http/application boundary",
    "domain-services": "business-state authority",
    "packages/db": "persistence"
  },
  "rules": {
    "sharedComponentsFetchData": false,
    "sharedComponentsCallMutationEndpoints": false,
    "uiCalculatesRanking": false,
    "uiCalculatesEligibility": false,
    "uiEvaluatesIntegrity": false,
    "uiAuthorisesEnvironment": false,
    "providerSpecificSharedComponents": false,
    "responsiveComparisonUsesSharedModel": true
